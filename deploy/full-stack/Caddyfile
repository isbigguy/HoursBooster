{
	admin off
	https_port 8443
	auto_https disable_redirects
	# HTTP error events can contain callback URLs and authentication cookies.
	# TLS certificate diagnostics remain available; access logging stays disabled.
	log {
		exclude http.log.error
	}
	servers {
		protocols h1 h2
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
}

https://{$HOURS_DOMAIN} {
	import /etc/caddy/tls.conf
	import security_headers
	reverse_proxy https://vaporbooster:8443 {
		header_up Host {$HOURS_DOMAIN}
		header_up X-Forwarded-Host {$HOURS_DOMAIN}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Port 443
		header_up -Forwarded
		transport http {
			tls_trust_pool file /run/ca/ca.pem
			tls_server_name vaporbooster
		}
	}
}

https://{$AUTH_DOMAIN} {
	import /etc/caddy/tls.conf
	import security_headers
	reverse_proxy https://keycloak:8443 {
		header_up Host {$AUTH_DOMAIN}
		header_up X-Forwarded-Host {$AUTH_DOMAIN}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Port 443
		header_up X-Forwarded-For {remote_host}
		header_up -Forwarded
		transport http {
			tls_trust_pool file /run/ca/ca.pem
			tls_server_name keycloak
		}
	}
}
